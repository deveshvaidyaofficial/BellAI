# Local SQLite. Enough for the first users on this machine.
# A shared hosted database (something like Postgres) comes later, when we scale.
DATABASE_URL=sqlite:///./bellai.db

# Bolna — https://platform.bolna.ai
BOLNA_MOCK=true
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_BASE_URL=https://api.bolna.ai
# Number Bolna calls from (optional, depends on your telephony setup)
BOLNA_FROM_PHONE_NUMBER=

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000
