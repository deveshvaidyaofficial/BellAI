# Local SQLite. Enough for the first users on this machine.
# A shared hosted database (something like Postgres) comes later, when we scale.
DATABASE_URL=sqlite:///./bellai.db

# Bolna — https://platform.bolna.ai
# BOLNA_MOCK=true by default for safe local development and testing.
# Set BOLNA_MOCK=false to initiate live voice calls through the configured Bolna agent.
BOLNA_MOCK=true
BOLNA_API_KEY=
BOLNA_AGENT_ID=c8fcf1f9-a513-4bff-83fc-2cb627bf6b1c
BOLNA_BASE_URL=https://api.bolna.ai
# Number Bolna calls from (optional, depends on your telephony setup)
BOLNA_FROM_PHONE_NUMBER=
# Shared secret for authenticating inbound Bolna webhooks (configured under Bolna dashboard's "Add headers")
BOLNA_WEBHOOK_SECRET=
BOLNA_TIMEOUT_SECONDS=15

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000
